# Copy to .env and export the variables. .env is gitignored.
# Leave the value empty until a real key exists. Never commit a key.
OPENAI_API_KEY=

# Optional. The CLI defaults to the fake provider so a key cannot be spent by accident.
# BASHAGENT_PROVIDER=openai
# BASHAGENT_MODEL=gpt-4.1-mini
# BASHAGENT_PLATFORM=auto
# BASHAGENT_EXPLAIN_LEVEL=kort
